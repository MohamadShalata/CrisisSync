@startuml

' CrisisSync — Use Case Diagram (Synced Version)
left to right direction
skinparam linetype polyline
skinparam nodesep 22
skinparam ranksep 100

' Human Actors (Left Side - Aligned in one vertical column)
together {
  actor "System\nAdministrator" as Admin
  actor "Logistics &\nResources Officer" as Logistics
  actor "Dispatcher" as Dispatcher
  actor "Field\nCommander" as Commander
  actor "Field Crew\nMember" as Crew
}

' Non-Human Actors (Right Side)
together {
  actor "National Billing &\nSettlement System" as Billing
  actor "Timer" as Timer
}

rectangle "CrisisSync" {

  ' System Administrator Use Cases
  usecase "Manage Users\nand Permissions" as UC_Users
  usecase "Load Initial Data" as UC_Load
  usecase "View and Filter\nEvent History" as UC_History
  usecase "View Reports" as UC_ViewReports
  usecase "Generate On-Demand\nReport" as UC_GenerateManual

  ' Timer / Automatic Use Cases
  usecase "Generate Monthly\nReport" as UC_GenerateAuto

  ' Logistics & Resources Officer Use Cases
  usecase "Update Equipment\nStatus" as UC_EquipmentStatus
  usecase "Transfer Equipment\nBetween Stations" as UC_Transfer
  usecase "Update Personnel\nAvailability" as UC_Personnel

  ' Shared Authentication
  usecase "Log In" as UC_Login

  ' Dispatcher Use Cases
  usecase "Create Emergency\nEvent" as UC_CreateEvent
  usecase "Cancel Event" as UC_CancelEvent
  usecase "Create Task" as UC_CreateTask
  usecase "Add or Modify\nTask Dependencies" as UC_Dependencies
  usecase "Validate Task\nDependencies" as UC_Validate
  usecase "Reject Cyclic Dependency" as UC_RejectCycle
  usecase "Manually Allocate\nResources" as UC_ManualAllocate
  usecase "Automatically Allocate\nResources" as UC_AutomaticAllocate
  usecase "Verify & Lock Resource Package" as UC_VerifyLockPackage
  usecase "Rollback Allocation on Resource Conflict" as UC_RollbackAllocation
  usecase "Fallback to Next Best Available Resource" as UC_FallbackResource
  usecase "Monitor Events\nin Real Time" as UC_Monitor
  usecase "Cancel Task" as UC_CancelTask
  usecase "Handle Dependent\nTask Cancellation" as UC_CancelDependent
  usecase "Close Event" as UC_Close
  usecase "Settle Event Costs" as UC_Settle
  usecase "Handle Settlement Rejection" as UC_SettlementRejection
  usecase "Allocate Replacement\nEquipment" as UC_Replace

  ' Field Commander & Crew Use Cases
  usecase "View Assigned\nEvents and Tasks" as UC_ViewAssignedEvents
  usecase "Report Task\nCompletion" as UC_CompleteTask
  usecase "Report Equipment\nFailure" as UC_ReportFailure
  usecase "Report Shift Start\nand Availability" as UC_Shift
  usecase "View Assigned Task" as UC_ViewAssignedTask
}

' Force strict vertical alignment on the left
Admin -[hidden]down- Logistics
Logistics -[hidden]down- Dispatcher
Dispatcher -[hidden]down- Commander
Commander -[hidden]down- Crew

' Human Actor Associations (Solid lines, NO arrowheads)
Admin -- UC_Users
Admin -- UC_Load
Admin -- UC_History
Admin -- UC_ViewReports
Admin -- UC_GenerateManual
Admin -- UC_Login

Logistics -- UC_EquipmentStatus
Logistics -- UC_Transfer
Logistics -- UC_Personnel
Logistics -- UC_Login

Dispatcher -- UC_Login
Dispatcher -- UC_CreateEvent
Dispatcher -- UC_CancelEvent
Dispatcher -- UC_CreateTask
Dispatcher -- UC_Dependencies
Dispatcher -- UC_ManualAllocate
Dispatcher -- UC_AutomaticAllocate
Dispatcher -- UC_Monitor
Dispatcher -- UC_CancelTask
Dispatcher -- UC_Close
Dispatcher -- UC_Replace

Commander -- UC_Login
Commander -- UC_ViewAssignedEvents
Commander -- UC_CompleteTask
Commander -- UC_ReportFailure

Crew -- UC_Login
Crew -- UC_ReportFailure
Crew -- UC_Shift
Crew -- UC_ViewAssignedTask

' Non-Human Actor Associations (Right Side)
UC_GenerateAuto ---- Timer
UC_Settle ---- Billing
Timer -[hidden]down- Billing

' Include Dependencies (Base ..> Included)
UC_Close ..> UC_Settle : <<include>>
UC_CreateTask ..> UC_Validate : <<include>>
UC_Dependencies ..> UC_Validate : <<include>>
UC_ManualAllocate ..> UC_VerifyLockPackage : <<include>>
UC_AutomaticAllocate ..> UC_VerifyLockPackage : <<include>>

' Extend Dependencies (Extension ..> Base)
UC_CancelDependent ..> UC_CancelTask : <<extend>>
UC_RejectCycle ..> UC_Validate : <<extend>>
UC_RollbackAllocation ..> UC_ManualAllocate : <<extend>>
UC_RollbackAllocation ..> UC_AutomaticAllocate : <<extend>>
UC_FallbackResource ..> UC_AutomaticAllocate : <<extend>>
UC_Replace ..> UC_ReportFailure : <<extend>>
UC_SettlementRejection ..> UC_Close : <<extend>>

@enduml